{
  "name": "pos-kds",
  "private": true,
  "type": "module",
  "description": "Offline-first restaurant POS, KDS, online ordering and admin platform",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "e2e": "turbo run test:e2e --concurrency=1",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "pnpm --filter @pos/database migrate:dev",
    "db:deploy": "pnpm --filter @pos/database migrate:deploy",
    "db:seed": "pnpm --filter @pos/database seed",
    "db:reset": "pnpm --filter @pos/database migrate:reset",
    "test:tools": "node --test \"tools/**/*.test.{js,mjs}\"",
    "printer:sim": "node tools/printer-sim/server.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.5.0",
    "prettier": "3.9.10",
    "turbo": "2.11.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "@swc/core",
      "esbuild",
      "prisma"
    ]
  }
}

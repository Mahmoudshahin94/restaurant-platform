        "orders.view",
        "orders.create",
        "orders.update",
        "payments.view",
        "shifts.manage",
        "tables.manage",
        "products.view",
        "customers.view",
        "locations.view"
      ]
    },
    {
      "name": "Kitchen",
      "description": "Kitchen display operator",
      "isSystem": false,
      "permissions": ["kitchen.view", "kitchen.update", "products.view", "locations.view"]

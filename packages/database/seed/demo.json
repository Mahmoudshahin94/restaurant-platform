        "customers.view",
        "reports.view",
        "locations.view",
        "online_ordering.manage",
        "devices.manage",
        "sync.view",
        "audit.view"
      ]
    },
    {
      "name": "Cashier",
      "description": "Takes orders and payments",
      "isSystem": false,

        "state": "OPEN",
        "acceptMinutes": 10,
        "pickupEnabled": true,
        "deliveryEnabled": true,
        "deliveryFee": 1000
      }
    }
  ],
  "roles": [
    {
      "name": "Owner",
      "description": "Full access",
      "isSystem": true,
      "permissions": "*"
    },
    {
      "name": "Manager",
      "description": "Runs a branch",
      "isSystem": false,
      "permissions": [
        "orders.view",
        "orders.create",
        "orders.update",
        "orders.cancel",
        "orders.refund",
        "orders.discount",
        "products.view",
        "products.create",
        "products.update",
        "payments.view",
        "payments.refund",
        "shifts.manage",
        "cash.manage",
        "tables.manage",
        "kitchen.view",
        "kitchen.update",
        "customers.view",
        "reports.view",
        "locations.view",
        "online_ordering.manage",
        "devices.manage",
        "kiosk.attend",
        "sync.view",
        "audit.view",
        "payments.create"
      ]
    },
    {
      "name": "Cashier",
      "description": "Takes orders and payments",
      "isSystem": false,
      "permissions": [
        "orders.view",
        "orders.create",
        "orders.update",
        "payments.view",
        "shifts.manage",
        "tables.manage",
        "products.view",
        "customers.view",
        "locations.view",
        "payments.create",
        "kiosk.attend"
      ]
    },
    {
      "name": "Kitchen",
      "description": "Kitchen display operator",
      "isSystem": false,

    "slug": "demo-kitchen",
    "nameEn": "Demo Kitchen",
    "nameAr": "مطبخ تجريبي",
    "currencyCode": "ILS",
    "defaultLocale": "en",
    "timezone": "Asia/Hebron"
  },

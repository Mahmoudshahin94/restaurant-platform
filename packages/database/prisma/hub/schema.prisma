// GENERATED by scripts/hub-schema.mjs from prisma/schema.prisma — do not edit by hand.
// Location hub (SQLite). Same models as the cloud, plus hub-only models at the end.
// Cloud PostgreSQL schema. Conventions (see docs/domain-model.md):
//  - IDs are UUIDv7 (`uuid(7)` here, `newId()` from @pos/domain on offline nodes).
//  - Timestamps are timestamptz, always UTC; presentation converts to the location timezone.
//  - Money is integer minor units of the restaurant currency; rates are integer basis points.
//  - Tables and columns are snake_case; Prisma fields are camelCase.
//  - Enum values mirror @pos/shared-types (enforced by src/enums.contract.test.ts).

generator client {
  provider = "prisma-client-js"
  output   = "../../generated/hub-client"
}

datasource db {
  provider = "sqlite"
  url      = env("HUB_DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Locale {
  en
  ar

  @@map("locale")
}

enum OnlineOrderingState {
  OPEN
  PAUSED
  CLOSED
  OFFLINE

  @@map("online_ordering_state")
}

enum DeviceType {
  POS
  KDS
  PRINTER
  KITCHEN_DISPLAY
  CUSTOMER_DISPLAY
  GATEWAY

  @@map("device_type")
}

enum DeviceStatus {
  PENDING
  ACTIVE
  DISABLED

  @@map("device_status")
}

enum OrderChannel {
  DINE_IN
  TAKEAWAY
  PHONE
  WEBSITE
  DELIVERY

  @@map("order_channel")
}

enum OrderStatus {
  DRAFT
  PLACED
  CONFIRMED
  PREPARING
  READY
  COMPLETED
  CANCELLED
  REFUNDED

  @@map("order_status")
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  PARTIALLY_REFUNDED
  REFUNDED

  @@map("payment_status")
}

enum DiscountType {
  PERCENTAGE
  FIXED

  @@map("discount_type")
}

enum PaymentMethodType {
  CASH
  CARD
  ONLINE

  @@map("payment_method_type")
}

enum PaymentTransactionType {
  CHARGE
  REFUND

  @@map("payment_transaction_type")
}

enum PaymentRecordStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  CANCELLED

  @@map("payment_record_status")
}

enum ShiftStatus {
  OPEN
  CLOSED

  @@map("shift_status")
}

enum CashTransactionType {
  SALE
  REFUND
  PAY_IN
  PAY_OUT

  @@map("cash_transaction_type")
}

enum KitchenTicketStatus {
  NEW
  PREPARING
  READY
  COMPLETED
  CANCELLED

  @@map("kitchen_ticket_status")
}

enum TicketPriority {
  NORMAL
  RUSH

  @@map("ticket_priority")
}

enum ActorType {
  USER
  EMPLOYEE
  DEVICE
  CUSTOMER
  SYSTEM

  @@map("actor_type")
}

enum ActionSource {
  POS
  KDS
  WEBSITE
  ADMIN
  HUB
  SYSTEM

  @@map("action_source")
}

// ---------------------------------------------------------------------------
// Tenancy
// ---------------------------------------------------------------------------

model Restaurant {
  id            String   @id @default(uuid(7))
  slug          String   @unique
  nameEn        String   @map("name_en")
  nameAr        String   @map("name_ar")
  /// ISO 4217. Immutable after provisioning: all amounts are stored in its minor units.
  currencyCode  String   @map("currency_code")
  defaultLocale Locale   @default(en) @map("default_locale")
  /// IANA timezone used for restaurant-level reporting.
  timezone      String
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  locations       Location[]
  users           User[]
  roles           Role[]
  employees       Employee[]
  devices         Device[]
  categories      Category[]
  products        Product[]
  modifierGroups  ModifierGroup[]
  kitchenStations KitchenStation[]
  kitchenTickets  KitchenTicket[]
  taxes           Tax[]
  discounts       Discount[]
  orders          Order[]
  paymentMethods  PaymentMethod[]

  @@map("restaurants")
}

model Location {
  id                    String              @id @default(uuid(7))
  restaurantId          String              @map("restaurant_id")
  /// Short code, unique within the restaurant; prefix of locally generated order numbers.
  code                  String
  nameEn                String              @map("name_en")
  nameAr                String              @map("name_ar")
  timezone              String
  /// Whether menu prices at this location already include tax.
  taxInclusive          Boolean             @map("tax_inclusive")
  onlineOrderingState   OnlineOrderingState @default(CLOSED) @map("online_ordering_state")
  /// Smallest coin for cash rounding in minor units (e.g. 5 = 0.05); null = no rounding.
  cashRoundingIncrement Int?                @map("cash_rounding_increment")
  /// Kitchen screen: tickets older than this many minutes are flagged, then flagged as late.
  kdsWarnMinutes        Int                 @default(8) @map("kds_warn_minutes")
  kdsLateMinutes        Int                 @default(15) @map("kds_late_minutes")
  addressLine           String?             @map("address_line")
  phone                 String?
  isActive              Boolean             @default(true) @map("is_active")
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")

  restaurant       Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  userRoles        UserRole[]
  employees        Employee[]
  devices          Device[]
  locationProducts LocationProduct[]
  tableSections    TableSection[]
  tables           DiningTable[]
  orders           Order[]
  orderCounters    OrderCounter[]
  cashRegisters    CashRegister[]
  shifts           Shift[]
  payments         Payment[]
  kitchenTickets   KitchenTicket[]

  @@unique([restaurantId, code])
  @@index([restaurantId])
  @@map("locations")
}

// ---------------------------------------------------------------------------
// Identity & access
// ---------------------------------------------------------------------------

model User {
  id              String    @id @default(uuid(7))
  restaurantId    String    @map("restaurant_id")
  /// Stored lowercase; globally unique so login needs no tenant selector.
  email           String    @unique
  /// argon2id hash. Never logged, never returned by the API.
  passwordHash    String    @map("password_hash")
  displayName     String    @map("display_name")
  preferredLocale Locale    @default(en) @map("preferred_locale")
  isActive        Boolean   @default(true) @map("is_active")
  lastLoginAt     DateTime? @map("last_login_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  restaurant    Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  roles         UserRole[]
  refreshTokens RefreshToken[]
  employee      Employee?

  @@index([restaurantId])
  @@map("users")
}

/// Permission keys are defined in code (@pos/shared-types PERMISSIONS) and upserted into this
/// table by `syncPermissionCatalog`, so role assignments are referentially valid.
model Permission {
  key       String           @id
  createdAt DateTime         @default(now()) @map("created_at")
  roles     RolePermission[]

  @@map("permissions")
}

model Role {
  id           String   @id @default(uuid(7))
  restaurantId String   @map("restaurant_id")
  name         String
  description  String?
  /// System roles (e.g. Owner) cannot be deleted or stripped of permissions.
  isSystem     Boolean  @default(false) @map("is_system")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  restaurant  Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  permissions RolePermission[]
  users       UserRole[]

  @@unique([restaurantId, name])
  @@map("roles")
}

model RolePermission {
  roleId        String @map("role_id")
  permissionKey String @map("permission_key")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: Restrict)

  @@id([roleId, permissionKey])
  @@map("role_permissions")
}

/// Grants a role to a user, restaurant-wide (`locationId` null) or for one location.
/// Uniqueness of (user, role, location) is enforced by the application service because
/// PostgreSQL treats NULL location ids as distinct.
model UserRole {
  id         String   @id @default(uuid(7))
  userId     String   @map("user_id")
  roleId     String   @map("role_id")
  locationId String?  @map("location_id")
  createdAt  DateTime @default(now()) @map("created_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  location Location? @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_roles")
}

/// Rotating refresh tokens. Only a SHA-256 hash is stored. Tokens of one login share a
/// `familyId`; presenting an already-rotated token revokes the whole family (reuse detection).
model RefreshToken {
  id           String    @id @default(uuid(7))
  userId       String    @map("user_id")
  familyId     String    @map("family_id")
  tokenHash    String    @unique @map("token_hash")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  replacedById String?   @map("replaced_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([userId])
  @@map("refresh_tokens")
}

/// Restaurant staff who operate the POS/KDS. May be linked to a User for back-office access.
/// POS PIN login (Phase 2) verifies `pinHash` on the location hub after it is synced down.
model Employee {
  id             String   @id @default(uuid(7))
  restaurantId   String   @map("restaurant_id")
  homeLocationId String?  @map("home_location_id")
  userId         String?  @unique @map("user_id")
  employeeCode   String   @map("employee_code")
  displayName    String   @map("display_name")
  /// argon2id hash of the POS PIN.
  pinHash        String?  @map("pin_hash")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  homeLocation Location?  @relation(fields: [homeLocationId], references: [id], onDelete: SetNull)
  user         User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([restaurantId, employeeCode])
  @@map("employees")
}

// ---------------------------------------------------------------------------
// Devices
// ---------------------------------------------------------------------------

model Device {
  id             String       @id @default(uuid(7))
  restaurantId   String       @map("restaurant_id")
  locationId     String       @map("location_id")
  name           String
  type           DeviceType
  status         DeviceStatus @default(PENDING)
  /// Hash of the device credential issued at registration (Phase 5).
  credentialHash String?      @map("credential_hash")
  lastSeenAt     DateTime?    @map("last_seen_at")
  /// Non-secret descriptive data: app version, OS, printer model, IP on the LAN.
  metadata       Json         @default("{}")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  location   Location   @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@index([locationId])
  @@map("devices")
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

/// Append-only. `metadata` is redacted of secrets before insert (AuditService).
model AuditLog {
  id           String        @id @default(uuid(7))
  restaurantId String?       @map("restaurant_id")
  locationId   String?       @map("location_id")
  actorType    ActorType     @map("actor_type")
  actorId      String?       @map("actor_id")
  source       ActionSource?
  action       String
  entityType   String        @map("entity_type")
  entityId     String?       @map("entity_id")
  metadata     Json          @default("{}")
  requestId    String?       @map("request_id")
  createdAt    DateTime      @default(now()) @map("created_at")

  @@index([restaurantId, createdAt])
  @@index([entityType, entityId])
  @@index([actorId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Catalog (menu). Restaurant-level definitions; per-location availability and price overrides
// live in LocationProduct. Rows are archived (archived_at), never deleted, because historical
// orders and sync operations reference them.
// ---------------------------------------------------------------------------

model Category {
  id            String    @id @default(uuid(7))
  restaurantId  String    @map("restaurant_id")
  nameEn        String    @map("name_en")
  nameAr        String    @map("name_ar")
  descriptionEn String?   @map("description_en")
  descriptionAr String?   @map("description_ar")
  sortOrder     Int       @default(0) @map("sort_order")
  archivedAt    DateTime? @map("archived_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  products   Product[]

  @@index([restaurantId, sortOrder])
  @@map("categories")
}

model Product {
  id            String    @id @default(uuid(7))
  restaurantId  String    @map("restaurant_id")
  categoryId    String    @map("category_id")
  /// Optional stock-keeping code, unique within the restaurant when present.
  sku           String?
  nameEn        String    @map("name_en")
  nameAr        String    @map("name_ar")
  descriptionEn String?   @map("description_en")
  descriptionAr String?   @map("description_ar")
  /// Minor units. When the product has variants, the chosen variant's price is used instead.
  price         Int
  sortOrder     Int       @default(0) @map("sort_order")
  archivedAt    DateTime? @map("archived_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  restaurant       Restaurant             @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  category         Category               @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants         ProductVariant[]
  modifierGroups   ProductModifierGroup[]
  stations         ProductStation[]
  locationSettings LocationProduct[]
  taxes            ProductTax[]
  orderItems       OrderItem[]

  @@unique([restaurantId, sku])
  @@index([restaurantId, categoryId, sortOrder])
  @@map("products")
}

model ProductVariant {
  id         String    @id @default(uuid(7))
  productId  String    @map("product_id")
  nameEn     String    @map("name_en")
  nameAr     String    @map("name_ar")
  /// Absolute price in minor units (not a delta).
  price      Int
  sortOrder  Int       @default(0) @map("sort_order")
  archivedAt DateTime? @map("archived_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([productId])
  @@map("product_variants")
}

model ModifierGroup {
  id           String    @id @default(uuid(7))
  restaurantId String    @map("restaurant_id")
  nameEn       String    @map("name_en")
  nameAr       String    @map("name_ar")
  /// Minimum number of modifiers the customer must choose (0 = optional group).
  minSelect    Int       @default(0) @map("min_select")
  /// Maximum number of modifiers; null = unlimited.
  maxSelect    Int?      @map("max_select")
  sortOrder    Int       @default(0) @map("sort_order")
  archivedAt   DateTime? @map("archived_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  restaurant Restaurant             @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  modifiers  Modifier[]
  products   ProductModifierGroup[]

  @@index([restaurantId])
  @@map("modifier_groups")
}

model Modifier {
  id              String    @id @default(uuid(7))
  modifierGroupId String    @map("modifier_group_id")
  nameEn          String    @map("name_en")
  nameAr          String    @map("name_ar")
  /// Added to the item's unit price, minor units (0 for free options).
  priceDelta      Int       @default(0) @map("price_delta")
  /// Pre-selected in ordering UIs.
  isDefault       Boolean   @default(false) @map("is_default")
  sortOrder       Int       @default(0) @map("sort_order")
  archivedAt      DateTime? @map("archived_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  group ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Restrict)

  @@index([modifierGroupId])
  @@map("modifiers")
}

/// Attaches a modifier group to a product, optionally overriding the group's min/max.
model ProductModifierGroup {
  productId       String @map("product_id")
  modifierGroupId String @map("modifier_group_id")
  sortOrder       Int    @default(0) @map("sort_order")
  minSelect       Int?   @map("min_select")
  maxSelect       Int?   @map("max_select")

  product Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  group   ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Restrict)

  @@id([productId, modifierGroupId])
  @@map("product_modifier_groups")
}

/// Kitchen stations (Kitchen, Grill, Fryer, Bar, Dessert, ...) are defined per restaurant; each
/// location's KDS screens subscribe to the stations they serve.
model KitchenStation {
  id           String    @id @default(uuid(7))
  restaurantId String    @map("restaurant_id")
  /// Short code, unique within the restaurant, e.g. GRILL.
  code         String
  nameEn       String    @map("name_en")
  nameAr       String    @map("name_ar")
  sortOrder    Int       @default(0) @map("sort_order")
  archivedAt   DateTime? @map("archived_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  restaurant Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  products   ProductStation[]
  tickets    KitchenTicket[]

  @@unique([restaurantId, code])
  @@map("kitchen_stations")
}

/// An order item is routed to every station its product is assigned to.
model ProductStation {
  productId        String @map("product_id")
  kitchenStationId String @map("kitchen_station_id")

  product Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  station KitchenStation @relation(fields: [kitchenStationId], references: [id], onDelete: Restrict)

  @@id([productId, kitchenStationId])
  @@map("product_stations")
}

/// Per-location product settings. A missing row means: available, base price.
model LocationProduct {
  locationId    String   @map("location_id")
  productId     String   @map("product_id")
  /// The "86" switch: false hides the product from ordering at this location.
  isAvailable   Boolean  @default(true) @map("is_available")
  /// Replaces the product base price at this location (minor units). Only for products
  /// without variants.
  priceOverride Int?     @map("price_override")
  updatedAt     DateTime @updatedAt @map("updated_at")

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@id([locationId, productId])
  @@map("location_products")
}

// ---------------------------------------------------------------------------
// Taxes & discounts (restaurant configuration)
// ---------------------------------------------------------------------------

model Tax {
  id           String    @id @default(uuid(7))
  restaurantId String    @map("restaurant_id")
  nameEn       String    @map("name_en")
  nameAr       String    @map("name_ar")
  /// Basis points: 1500 = 15%.
  rateBps      Int       @map("rate_bps")
  /// Pre-selected for new products in the admin. Pricing never applies taxes implicitly.
  isDefault    Boolean   @default(false) @map("is_default")
  archivedAt   DateTime? @map("archived_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  restaurant Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  products   ProductTax[]

  @@index([restaurantId])
  @@map("taxes")
}

model ProductTax {
  productId String @map("product_id")
  taxId     String @map("tax_id")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tax     Tax     @relation(fields: [taxId], references: [id], onDelete: Restrict)

  @@id([productId, taxId])
  @@map("product_taxes")
}

/// Predefined order-level discounts staff may apply (requires orders.discount).
model Discount {
  id           String       @id @default(uuid(7))
  restaurantId String       @map("restaurant_id")
  nameEn       String       @map("name_en")
  nameAr       String       @map("name_ar")
  type         DiscountType
  /// Basis points for PERCENTAGE, minor units for FIXED.
  value        Int
  archivedAt   DateTime?    @map("archived_at")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)

  @@index([restaurantId])
  @@map("discounts")
}

// ---------------------------------------------------------------------------
// Floor plan
// ---------------------------------------------------------------------------

model TableSection {
  id         String    @id @default(uuid(7))
  locationId String    @map("location_id")
  nameEn     String    @map("name_en")
  nameAr     String    @map("name_ar")
  sortOrder  Int       @default(0) @map("sort_order")
  archivedAt DateTime? @map("archived_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  location Location      @relation(fields: [locationId], references: [id], onDelete: Restrict)
  tables   DiningTable[]

  @@index([locationId])
  @@map("table_sections")
}

/// A dining table ("Table" in the domain model; renamed to avoid the SQL keyword).
model DiningTable {
  id         String    @id @default(uuid(7))
  locationId String    @map("location_id")
  sectionId  String    @map("section_id")
  /// Short label shown on the POS and tickets, unique per location, e.g. "T12".
  label      String
  seats      Int       @default(4)
  sortOrder  Int       @default(0) @map("sort_order")
  archivedAt DateTime? @map("archived_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  location Location     @relation(fields: [locationId], references: [id], onDelete: Restrict)
  section  TableSection @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  orders   Order[]

  @@unique([locationId, label])
  @@map("dining_tables")
}

// ---------------------------------------------------------------------------
// Orders. One table for every channel. Lines, modifiers, taxes and discounts are snapshots:
// later menu edits never change an order. Orders are never deleted.
// ---------------------------------------------------------------------------

model Order {
  id            String        @id @default(uuid(7))
  restaurantId  String        @map("restaurant_id")
  locationId    String        @map("location_id")
  /// Human-readable, unique per location and business day, e.g. "MAIN-042".
  orderNumber   String        @map("order_number")
  businessDate  DateTime      @map("business_date")
  channel       OrderChannel
  status        OrderStatus
  paymentStatus PaymentStatus @default(UNPAID) @map("payment_status")
  source        ActionSource
  tableId       String?       @map("table_id")
  customerName  String?       @map("customer_name")
  customerPhone String?       @map("customer_phone")
  guestCount    Int?          @map("guest_count")
  notes         String?
  /// Snapshots of the pricing context at the time of the last pricing.
  currencyCode  String        @map("currency_code")
  taxInclusive  Boolean       @map("tax_inclusive")
  subtotal      Int
  discountTotal Int           @map("discount_total")
  taxTotal      Int           @map("tax_total")
  feeTotal      Int           @map("fee_total")
  total         Int
  /// Incremented on every change; clients send it back for optimistic concurrency.
  version       Int           @default(1)
  createdById   String?       @map("created_by_id")
  placedAt      DateTime?     @map("placed_at")
  completedAt   DateTime?     @map("completed_at")
  cancelledAt   DateTime?     @map("cancelled_at")
  cancelReason  String?       @map("cancel_reason")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  restaurant    Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  location      Location             @relation(fields: [locationId], references: [id], onDelete: Restrict)
  table         DiningTable?         @relation(fields: [tableId], references: [id], onDelete: Restrict)
  items         OrderItem[]
  taxes         OrderTax[]
  discounts     OrderDiscount[]
  statusHistory OrderStatusHistory[]
  payments      Payment[]
  tickets       KitchenTicket[]

  @@unique([locationId, businessDate, orderNumber])
  @@index([locationId, status])
  @@index([locationId, businessDate])
  @@index([tableId, status])
  @@map("orders")
}

model OrderItem {
  /// The client's cart line id, stable across edits.
  id            String   @id
  orderId       String   @map("order_id")
  productId     String   @map("product_id")
  variantId     String?  @map("variant_id")
  nameEn        String   @map("name_en")
  nameAr        String   @map("name_ar")
  variantNameEn String?  @map("variant_name_en")
  variantNameAr String?  @map("variant_name_ar")
  quantity      Int
  /// Product or variant price, before modifiers.
  basePrice     Int      @map("base_price")
  /// basePrice + modifier deltas.
  unitPrice     Int      @map("unit_price")
  gross         Int
  discount      Int
  tax           Int
  total         Int
  notes         String?
  /// Kitchen stations at the time of ordering (routing snapshot for Phase 4).
  /// JSON array of station ids (portable across PostgreSQL and the hub's SQLite).
  stationIds    Json     @default("[]") @map("station_ids")
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  order       Order               @relation(fields: [orderId], references: [id], onDelete: Restrict)
  product     Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  modifiers   OrderItemModifier[]
  ticketItems KitchenTicketItem[]

  @@index([orderId])
  @@map("order_items")
}

model OrderItemModifier {
  id              String @id @default(uuid(7))
  orderItemId     String @map("order_item_id")
  modifierId      String @map("modifier_id")
  modifierGroupId String @map("modifier_group_id")
  nameEn          String @map("name_en")
  nameAr          String @map("name_ar")
  priceDelta      Int    @map("price_delta")

  item OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderItemId])
  @@map("order_item_modifiers")
}

/// Per-tax totals of an order (receipt and tax-report breakdown).
model OrderTax {
  orderId       String @map("order_id")
  taxId         String @map("tax_id")
  nameEn        String @map("name_en")
  nameAr        String @map("name_ar")
  rateBps       Int    @map("rate_bps")
  taxableAmount Int    @map("taxable_amount")
  amount        Int

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@id([orderId, taxId])
  @@map("order_taxes")
}

model OrderDiscount {
  id          String       @id @default(uuid(7))
  orderId     String       @map("order_id")
  discountId  String       @map("discount_id")
  nameEn      String       @map("name_en")
  nameAr      String       @map("name_ar")
  type        DiscountType
  value       Int
  amount      Int
  appliedById String?      @map("applied_by_id")
  createdAt   DateTime     @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@map("order_discounts")
}

/// Append-only record of every status change.
model OrderStatusHistory {
  id         String       @id @default(uuid(7))
  orderId    String       @map("order_id")
  fromStatus OrderStatus? @map("from_status")
  toStatus   OrderStatus  @map("to_status")
  actorType  ActorType    @map("actor_type")
  actorId    String?      @map("actor_id")
  source     ActionSource
  reason     String?
  createdAt  DateTime     @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

/// Per-location, per-business-day order number sequence (incremented atomically).
model OrderCounter {
  locationId   String   @map("location_id")
  businessDate DateTime @map("business_date")
  lastNumber   Int      @map("last_number")

  location Location @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@id([locationId, businessDate])
  @@map("order_counters")
}

// ---------------------------------------------------------------------------
// Payments, shifts and cash. Financial rows are append-only: corrections are new rows
// (refunds, pay-outs), never edits or deletes.
// ---------------------------------------------------------------------------

/// A tender the restaurant accepts, e.g. "Cash", "Mada", "Visa".
model PaymentMethod {
  id           String            @id @default(uuid(7))
  restaurantId String            @map("restaurant_id")
  type         PaymentMethodType
  nameEn       String            @map("name_en")
  nameAr       String            @map("name_ar")
  sortOrder    Int               @default(0) @map("sort_order")
  archivedAt   DateTime?         @map("archived_at")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  payments   Payment[]

  @@index([restaurantId])
  @@map("payment_methods")
}

/// One money movement on an order. The id is client-generated and is the idempotency key.
model Payment {
  id                 String                 @id
  restaurantId       String                 @map("restaurant_id")
  locationId         String                 @map("location_id")
  orderId            String                 @map("order_id")
  shiftId            String                 @map("shift_id")
  paymentMethodId    String                 @map("payment_method_id")
  /// Snapshot of the method type and names at the time of payment.
  methodType         PaymentMethodType      @map("method_type")
  methodNameEn       String                 @map("method_name_en")
  methodNameAr       String                 @map("method_name_ar")
  type               PaymentTransactionType
  status             PaymentRecordStatus
  /// Provider adapter that processed it (e.g. "cash", "external-card").
  provider           String
  /// Provider-side id (gateway transaction id); null for cash.
  providerRef        String?                @map("provider_ref")
  /// Applied to the order (minor units, always positive).
  amount             Int
  /// Cash handed over (CASH charges only).
  tendered           Int?
  /// Cash returned to the customer (CASH charges only).
  change             Int                    @default(0)
  /// Cash rounding difference kept in the drawer (CASH charges only).
  roundingAdjustment Int                    @default(0) @map("rounding_adjustment")
  /// Card approval code / terminal receipt number. Never a card number.
  reference          String?
  /// REFUND rows: the CHARGE being refunded.
  refundOfId         String?                @map("refund_of_id")
  reason             String?
  createdById        String?                @map("created_by_id")
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")

  location Location          @relation(fields: [locationId], references: [id], onDelete: Restrict)
  order    Order             @relation(fields: [orderId], references: [id], onDelete: Restrict)
  shift    Shift             @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  method   PaymentMethod     @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)
  refundOf Payment?          @relation("PaymentRefunds", fields: [refundOfId], references: [id], onDelete: Restrict)
  refunds  Payment[]         @relation("PaymentRefunds")
  cash     CashTransaction[]

  @@index([orderId])
  @@index([shiftId])
  @@index([locationId, createdAt])
  @@map("payments")
}

/// A physical cash drawer at a location.
model CashRegister {
  id         String    @id @default(uuid(7))
  locationId String    @map("location_id")
  nameEn     String    @map("name_en")
  nameAr     String    @map("name_ar")
  archivedAt DateTime? @map("archived_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  location Location @relation(fields: [locationId], references: [id], onDelete: Restrict)
  shifts   Shift[]

  @@index([locationId])
  @@map("cash_registers")
}

model Shift {
  id             String      @id
  restaurantId   String      @map("restaurant_id")
  locationId     String      @map("location_id")
  cashRegisterId String      @map("cash_register_id")
  status         ShiftStatus
  /// Equals cashRegisterId while the shift is open and null once closed: the unique index
  /// guarantees at most one open shift per drawer, even under concurrent requests.
  openRegisterId String?     @unique @map("open_register_id")
  openingFloat   Int         @map("opening_float")
  openedById     String      @map("opened_by_id")
  openedAt       DateTime    @default(now()) @map("opened_at")
  closedById     String?     @map("closed_by_id")
  closedAt       DateTime?   @map("closed_at")
  /// Snapshot at closing: what the drawer should contain, what was counted, and the difference.
  expectedCash   Int?        @map("expected_cash")
  countedCash    Int?        @map("counted_cash")
  cashDifference Int?        @map("cash_difference")
  closingNotes   String?     @map("closing_notes")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  location     Location          @relation(fields: [locationId], references: [id], onDelete: Restrict)
  cashRegister CashRegister      @relation(fields: [cashRegisterId], references: [id], onDelete: Restrict)
  payments     Payment[]
  cash         CashTransaction[]

  @@index([locationId, status])
  @@map("shifts")
}

/// Cash movements in a drawer during a shift (sales and refunds are linked to their payment).
model CashTransaction {
  id          String              @id
  shiftId     String              @map("shift_id")
  type        CashTransactionType
  /// Positive minor units; the type gives the direction.
  amount      Int
  paymentId   String?             @map("payment_id")
  reason      String?
  createdById String?             @map("created_by_id")
  createdAt   DateTime            @default(now()) @map("created_at")

  shift   Shift    @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([shiftId])
  @@map("cash_transactions")
}

// ---------------------------------------------------------------------------
// Kitchen (Phase 4)
// ---------------------------------------------------------------------------

/// One per order and station. Created when the order is confirmed; the order's PREPARING/READY
/// statuses are derived from its tickets. Never deleted: cancelled tickets stay for history.
model KitchenTicket {
  id           String              @id @default(uuid(7))
  restaurantId String              @map("restaurant_id")
  locationId   String              @map("location_id")
  orderId      String              @map("order_id")
  stationId    String              @map("station_id")
  status       KitchenTicketStatus @default(NEW)
  priority     TicketPriority      @default(NORMAL)
  /// Incremented on every change; kitchen screens send it back for optimistic concurrency.
  version      Int                 @default(1)
  /// Incremented when an order edit rewrites the items; screens flag tickets with revision > 1.
  revision     Int                 @default(1)
  startedAt    DateTime?           @map("started_at")
  readyAt      DateTime?           @map("ready_at")
  completedAt  DateTime?           @map("completed_at")
  cancelledAt  DateTime?           @map("cancelled_at")
  /// A cancelled ticket stays on the screen until the kitchen acknowledges it.
  dismissedAt  DateTime?           @map("dismissed_at")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  restaurant Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  location   Location            @relation(fields: [locationId], references: [id], onDelete: Restrict)
  order      Order               @relation(fields: [orderId], references: [id], onDelete: Restrict)
  station    KitchenStation      @relation(fields: [stationId], references: [id], onDelete: Restrict)
  items      KitchenTicketItem[]

  @@unique([orderId, stationId])
  @@index([locationId, status])
  @@index([locationId, updatedAt])
  @@map("kitchen_tickets")
}

/// What the station has to make: a snapshot of the order line (names, quantity, modifiers, notes).
model KitchenTicketItem {
  id            String    @id @default(uuid(7))
  ticketId      String    @map("ticket_id")
  orderItemId   String    @map("order_item_id")
  nameEn        String    @map("name_en")
  nameAr        String    @map("name_ar")
  variantNameEn String?   @map("variant_name_en")
  variantNameAr String?   @map("variant_name_ar")
  quantity      Int
  notes         String?
  /// [{ nameEn, nameAr }] in selection order.
  modifiers     Json      @default("[]")
  sortOrder     Int       @default(0) @map("sort_order")
  /// Struck through on the screen when the cook finished this line.
  doneAt        DateTime? @map("done_at")

  ticket    KitchenTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  orderItem OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([orderItemId])
  @@map("kitchen_ticket_items")
}

// Models that exist only in the location hub's SQLite database. Appended to the generated hub
// schema by scripts/hub-schema.mjs.

enum SyncOperationStatus {
  PENDING
  PROCESSING
  FAILED
  COMPLETED

  @@map("sync_operation_status")
}

/// Outbox: every change that must reach the cloud, written in the same transaction as the change
/// itself (docs/sync.md). Rows are never deleted while pending or failed.
model SyncOperation {
  id            String              @id @default(uuid(7))
  /// UUIDv7; the cloud's idempotency key for this operation.
  operationId   String              @unique @map("operation_id")
  entityType    String              @map("entity_type")
  entityId      String              @map("entity_id")
  operationType String              @map("operation_type")
  payload       Json
  entityVersion Int                 @map("entity_version")
  status        SyncOperationStatus @default(PENDING)
  retryCount    Int                 @default(0) @map("retry_count")
  nextRetryAt   DateTime?           @map("next_retry_at")
  errorMessage  String?             @map("error_message")
  createdAt     DateTime            @default(now()) @map("created_at")
  processedAt   DateTime?           @map("processed_at")

  @@index([status, nextRetryAt])
  @@index([entityId, createdAt])
  @@map("sync_operations")
}

/// The hub's link to the cloud: pairing, last snapshot, sync cursors. One row per key.
model HubState {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("hub_state")
}

// Models that exist only in the location hub's SQLite database. Appended to the generated hub
// schema by scripts/hub-schema.mjs.

enum SyncOperationStatus {
  PENDING
  PROCESSING
  FAILED
  COMPLETED

  @@map("sync_operation_status")
}

/// Outbox: every change that must reach the cloud, written in the same transaction as the change
/// itself (docs/sync.md). Rows are never deleted while pending or failed.
model SyncOperation {
  id            String              @id @default(uuid(7))
  /// UUIDv7; the cloud's idempotency key for this operation.
  operationId   String              @unique @map("operation_id")
  entityType    String              @map("entity_type")
  entityId      String              @map("entity_id")
  operationType String              @map("operation_type")
  payload       Json
  entityVersion Int                 @map("entity_version")
  status        SyncOperationStatus @default(PENDING)
  retryCount    Int                 @default(0) @map("retry_count")
  nextRetryAt   DateTime?           @map("next_retry_at")
  /// Error code of the last failure (`SYNC_CONFLICT`, `SYNC_UNAVAILABLE`, …); the POS localizes it.
  errorCode     String?             @map("error_code")
  errorMessage  String?             @map("error_message")
  createdAt     DateTime            @default(now()) @map("created_at")
  processedAt   DateTime?           @map("processed_at")

  @@index([status, nextRetryAt])
  @@index([entityId, createdAt])
  @@map("sync_operations")
}

/// The hub's link to the cloud: pairing, last snapshot, change-feed cursor. One row per key.
model HubState {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("hub_state")
}

/// Website orders received from the cloud's change feed, with the cloud version the hub last
/// stored. Until the hub's first change of such an order is accepted by the cloud, the cloud owns
/// it; that first push names this version (`baseVersion`) so the cloud can hand it over (ADR 0013).
model InboundOrder {
  orderId      String   @id @map("order_id")
  cloudVersion Int      @map("cloud_version")
  receivedAt   DateTime @default(now()) @map("received_at")

  @@map("inbound_orders")
}

// Cloud PostgreSQL schema. Conventions (see docs/domain-model.md):
//  - IDs are UUIDv7 (`uuid(7)` here, `newId()` from @pos/domain on offline nodes).
//  - Timestamps are timestamptz, always UTC; presentation converts to the location timezone.
//  - Money is integer minor units of the tenant currency; rates are integer basis points.
//  - Tables and columns are snake_case; Prisma fields are camelCase.
//  - Enum values mirror @pos/shared-types (enforced by src/enums.contract.test.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Locale {
  en
  ar

  @@map("locale")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED

  @@map("tenant_status")
}

enum OnlineOrderingState {
  OPEN
  PAUSED
  CLOSED
  OFFLINE

  @@map("online_ordering_state")
}

enum DeviceType {
  POS
  KDS
  PRINTER
  KITCHEN_DISPLAY
  CUSTOMER_DISPLAY
  GATEWAY

  @@map("device_type")
}

enum DeviceStatus {
  PENDING
  ACTIVE
  DISABLED

  @@map("device_status")
}

enum OrderChannel {
  DINE_IN
  TAKEAWAY
  PHONE
  WEBSITE
  DELIVERY

  @@map("order_channel")
}

/// How a website order reaches the customer.
enum FulfillmentType {
  PICKUP
  DELIVERY

  @@map("fulfillment_type")
}

enum OrderStatus {
  DRAFT
  PLACED
  CONFIRMED
  PREPARING
  READY
  COMPLETED
  CANCELLED
  REFUNDED

  @@map("order_status")
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  PARTIALLY_REFUNDED
  REFUNDED

  @@map("payment_status")
}

enum DiscountType {
  PERCENTAGE
  FIXED

  @@map("discount_type")
}

enum PaymentMethodType {
  CASH
  CARD
  ONLINE

  @@map("payment_method_type")
}

enum PaymentTransactionType {
  CHARGE
  REFUND

  @@map("payment_transaction_type")
}

enum PaymentRecordStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  CANCELLED

  @@map("payment_record_status")
}

enum ShiftStatus {
  OPEN
  CLOSED

  @@map("shift_status")
}

enum CashTransactionType {
  SALE
  REFUND
  PAY_IN
  PAY_OUT

  @@map("cash_transaction_type")
}

enum KitchenTicketStatus {
  NEW
  PREPARING
  READY
  COMPLETED
  CANCELLED

  @@map("kitchen_ticket_status")
}

enum TicketPriority {
  NORMAL
  RUSH

  @@map("ticket_priority")
}

enum ActorType {
  USER
  EMPLOYEE
  DEVICE
  CUSTOMER
  SYSTEM

  @@map("actor_type")
}

enum ActionSource {
  POS
  KDS
  WEBSITE
  ADMIN
  HUB
  SYSTEM

  @@map("action_source")
}

// ---------------------------------------------------------------------------
// Tenancy
// ---------------------------------------------------------------------------

/// The root business entity (ADR 0017): a restaurant, café, supermarket, shop... Every business
/// row belongs to exactly one tenant.
model Tenant {
  id                   String       @id @default(uuid(7)) @db.Uuid
  slug                 String       @unique
  nameEn               String       @map("name_en")
  nameAr               String       @map("name_ar")
  /// Registered company name for invoices and contracts, when it differs from the display name.
  legalName            String?      @map("legal_name")
  /// @pos/shared-types BusinessType, stored as text so new types need no migration. It only picks
  /// default configuration; code asks for capabilities, never for the type.
  businessType         String       @default("RESTAURANT") @map("business_type")
  status               TenantStatus @default(ACTIVE)
  /// ISO 4217. Immutable after provisioning: all amounts are stored in its minor units.
  currencyCode         String       @default("ILS") @map("currency_code") @db.Char(3)
  /// Currency display (ADR 0020); null inherits MADAR's. Written instead of Intl's symbol.
  currencySymbol       String?      @map("currency_symbol")
  /// @pos/shared-types CurrencyDisplay: narrowSymbol, symbol or code.
  currencyDisplay      String?      @map("currency_display")
  /// @pos/shared-types FORMAT_LOCALES: amounts use it on every screen instead of the UI language.
  currencyFormatLocale String?      @map("currency_format_locale")
  defaultLocale        Locale       @default(en) @map("default_locale")
  /// Locales the tenant offers (JSON array of Locale, includes `defaultLocale`).
  supportedLocales     Json         @default("[\"en\",\"ar\"]") @map("supported_locales")
  /// @pos/shared-types DigitStyle for Arabic (latn, arab); null inherits MADAR's Latin digits.
  digits               String?
  /// IANA timezone used for tenant-level reporting.
  timezone             String
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  locations        Location[]
  users            User[]
  roles            Role[]
  employees        Employee[]
  devices          Device[]
  categories       Category[]
  products         Product[]
  modifierGroups   ModifierGroup[]
  kitchenStations  KitchenStation[]
  kitchenTickets   KitchenTicket[]
  taxes            Tax[]
  discounts        Discount[]
  orders           Order[]
  paymentMethods   PaymentMethod[]
  entitlements     TenantEntitlement[]
  featureOverrides FeatureOverride[]
  branding         TenantBranding?
  files            TenantFile[]

  @@map("tenants")
}

model Location {
  id                    String              @id @default(uuid(7)) @db.Uuid
  tenantId              String              @map("tenant_id") @db.Uuid
  /// Short code, unique within the tenant; prefix of locally generated order numbers.
  code                  String
  nameEn                String              @map("name_en")
  nameAr                String              @map("name_ar")
  timezone              String
  /// Whether menu prices at this location already include tax.
  taxInclusive          Boolean             @map("tax_inclusive")
  /// Set by the tenant (OPEN/PAUSED/CLOSED). What customers see also depends on the opening
  /// hours and on the hub being online (domain `onlineOrderingStatus`).
  onlineOrderingState   OnlineOrderingState @default(CLOSED) @map("online_ordering_state")
  /// Weekly opening hours for online orders: [{ day: 0-6 (Sunday = 0), open: "HH:MM",
  /// close: "HH:MM" }] in the location timezone; a close at or before the open ends the next
  /// day. Empty = no restriction.
  openingHours          Json                @default("[]") @map("opening_hours")
  /// Minutes the tenant has to accept a website order before it is cancelled automatically.
  onlineAcceptMinutes   Int                 @default(10) @map("online_accept_minutes")
  onlinePickupEnabled   Boolean             @default(true) @map("online_pickup_enabled")
  onlineDeliveryEnabled Boolean             @default(false) @map("online_delivery_enabled")
  /// Delivery fee of website orders, minor units (untaxed).
  onlineDeliveryFee     Int                 @default(0) @map("online_delivery_fee")
  /// Smallest coin for cash rounding in minor units (e.g. 5 = 0.05); null = no rounding.
  cashRoundingIncrement Int?                @map("cash_rounding_increment")
  /// Kitchen screen: tickets older than this many minutes are flagged, then flagged as late.
  kdsWarnMinutes        Int                 @default(8) @map("kds_warn_minutes")
  kdsLateMinutes        Int                 @default(15) @map("kds_late_minutes")
  addressLine           String?             @map("address_line")
  phone                 String?
  isActive              Boolean             @default(true) @map("is_active")
  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  userRoles        UserRole[]
  employees        Employee[]
  devices          Device[]
  locationProducts LocationProduct[]
  tableSections    TableSection[]
  tables           DiningTable[]
  orders           Order[]
  orderCounters    OrderCounter[]
  cashRegisters    CashRegister[]
  shifts           Shift[]
  payments         Payment[]
  kitchenTickets   KitchenTicket[]
  featureOverrides FeatureOverride[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("locations")
}

// ---------------------------------------------------------------------------
// Identity & access
// ---------------------------------------------------------------------------

model User {
  id              String    @id @default(uuid(7)) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  /// Stored lowercase; globally unique so login needs no tenant selector.
  email           String    @unique
  /// argon2id hash. Never logged, never returned by the API.
  passwordHash    String    @map("password_hash")
  displayName     String    @map("display_name")
  preferredLocale Locale    @default(en) @map("preferred_locale")
  isActive        Boolean   @default(true) @map("is_active")
  lastLoginAt     DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  roles         UserRole[]
  refreshTokens RefreshToken[]
  employee      Employee?

  @@index([tenantId])
  @@map("users")
}

/// Permission keys are defined in code (@pos/shared-types PERMISSIONS) and upserted into this
/// table by `syncPermissionCatalog`, so role assignments are referentially valid.
model Permission {
  key       String           @id
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  roles     RolePermission[]

  @@map("permissions")
}

model Role {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String
  description String?
  /// System roles (e.g. Owner) cannot be deleted or stripped of permissions.
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  permissions RolePermission[]
  users       UserRole[]

  @@unique([tenantId, name])
  @@map("roles")
}

model RolePermission {
  roleId        String @map("role_id") @db.Uuid
  permissionKey String @map("permission_key")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: Restrict)

  @@id([roleId, permissionKey])
  @@map("role_permissions")
}

/// Grants a role to a user, tenant-wide (`locationId` null) or for one location.
/// Uniqueness of (user, role, location) is enforced by the application service because
/// PostgreSQL treats NULL location ids as distinct.
model UserRole {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  locationId String?  @map("location_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  location Location? @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_roles")
}

/// Rotating refresh tokens. Only a SHA-256 hash is stored. Tokens of one login share a
/// `familyId`; presenting an already-rotated token revokes the whole family (reuse detection).
model RefreshToken {
  id           String    @id @default(uuid(7)) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  familyId     String    @map("family_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedById String?   @map("replaced_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([userId])
  @@map("refresh_tokens")
}

/// Tenant staff who operate the POS/KDS. May be linked to a User for back-office access.
/// POS PIN login (Phase 2) verifies `pinHash` on the location hub after it is synced down.
model Employee {
  id             String   @id @default(uuid(7)) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  homeLocationId String?  @map("home_location_id") @db.Uuid
  userId         String?  @unique @map("user_id") @db.Uuid
  employeeCode   String   @map("employee_code")
  displayName    String   @map("display_name")
  /// argon2id hash of the POS PIN.
  pinHash        String?  @map("pin_hash")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  homeLocation Location? @relation(fields: [homeLocationId], references: [id], onDelete: SetNull)
  user         User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([tenantId, employeeCode])
  @@map("employees")
}

// ---------------------------------------------------------------------------
// Devices
// ---------------------------------------------------------------------------

model Device {
  id             String       @id @default(uuid(7)) @db.Uuid
  tenantId       String       @map("tenant_id") @db.Uuid
  locationId     String       @map("location_id") @db.Uuid
  name           String
  type           DeviceType
  status         DeviceStatus @default(PENDING)
  /// Hash of the device credential issued at registration (Phase 5).
  credentialHash String?      @map("credential_hash")
  lastSeenAt     DateTime?    @map("last_seen_at") @db.Timestamptz(3)
  /// Non-secret descriptive data: app version, OS, printer model, IP on the LAN.
  metadata       Json         @default("{}")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  location         Location          @relation(fields: [locationId], references: [id], onDelete: Restrict)
  featureOverrides FeatureOverride[]

  @@index([locationId])
  @@map("devices")
}

// ---------------------------------------------------------------------------
// Modules (ADR 0018)
// ---------------------------------------------------------------------------

/// What the platform allows a tenant for one module (@pos/shared-types Feature), set by the
/// platform operator only. A module without a row is entitled and configurable (the default
/// until plans are sold, Phase M9).
model TenantEntitlement {
  tenantId           String   @map("tenant_id") @db.Uuid
  /// @pos/shared-types Feature, stored as text so a new module needs no migration.
  feature            String
  /// Without it the module is off for the tenant, whatever its overrides say.
  entitled           Boolean
  /// Whether tenant administrators may switch the module (tenant, location and device overrides).
  tenantConfigurable Boolean  @map("tenant_configurable")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, feature])
  @@map("tenant_entitlements")
}

/// A tenant administrator switching a module on or off for the whole tenant (no location, no
/// device), one location, or one device (which also names its location). Only modules the
/// tenant is entitled to and may configure; resolution ignores any other.
model FeatureOverride {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  locationId String?  @map("location_id") @db.Uuid
  deviceId   String?  @map("device_id") @db.Uuid
  /// What the row applies to: `tenant`, `location:<id>` or `device:<id>`. Derived from the two
  /// ids (a check constraint keeps them consistent) so one override per scope is unique on
  /// PostgreSQL and SQLite alike, where nullable columns never collide in a unique index.
  scope      String
  /// @pos/shared-types Feature.
  feature    String
  enabled    Boolean
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location Location? @relation(fields: [locationId], references: [id], onDelete: Cascade)
  device   Device?   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([tenantId, scope, feature])
  @@index([locationId])
  @@map("feature_overrides")
}

// ---------------------------------------------------------------------------
// Branding (ADR 0019)
// ---------------------------------------------------------------------------

/// A tenant's branding: one row per tenant, absent until it is first saved. A null column
/// inherits MADAR's default (docs/configuration.md); `surfaces` holds the per-surface overrides.
model TenantBranding {
  tenantId       String   @id @map("tenant_id") @db.Uuid
  displayNameEn  String?  @map("display_name_en")
  displayNameAr  String?  @map("display_name_ar")
  logoFileId     String?  @map("logo_file_id") @db.Uuid
  faviconFileId  String?  @map("favicon_file_id") @db.Uuid
  /// `#rrggbb`, checked for contrast when saved.
  primaryColor   String?  @map("primary_color")
  secondaryColor String?  @map("secondary_color")
  accentColor    String?  @map("accent_color")
  /// @pos/shared-types FontFamily, LogoSize, ThemeMode and SurfaceStyle, stored as text.
  fontFamily     String?  @map("font_family")
  logoSize       String?  @map("logo_size")
  themeMode      String?  @map("theme_mode")
  surfaceStyle   String?  @map("surface_style")
  /// Corner radius in pixels.
  borderRadius   Int?     @map("border_radius")
  /// Per-surface overrides (`login`, `pos`, `kds`, `kiosk`, `website`), validated by
  /// @pos/validation `surfaceOverridesSchema`. File ids in it refer to `tenant_files`.
  surfaces       Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant  Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  logo    TenantFile? @relation("BrandingLogo", fields: [logoFileId], references: [id], onDelete: SetNull)
  favicon TenantFile? @relation("BrandingFavicon", fields: [faviconFileId], references: [id], onDelete: SetNull)

  @@index([logoFileId])
  @@index([faviconFileId])
  @@map("tenant_branding")
}

/// A file a tenant uploaded (logos and favicons). Immutable: a new upload is a new file. The
/// bytes live in the tenant file storage under `storageKey`, which always starts with
/// `tenants/<tenantId>/` (a check constraint in the cloud).
model TenantFile {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  /// @pos/shared-types TenantFileKind.
  kind        String
  storageKey  String   @unique @map("storage_key")
  /// The verified image type (PNG, JPEG, WebP or ICO; never SVG).
  contentType String   @map("content_type")
  sizeBytes   Int      @map("size_bytes")
  /// Hex SHA-256 of the bytes: the hub checks the copy it receives against it.
  sha256      String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  brandingLogo    TenantBranding[] @relation("BrandingLogo")
  brandingFavicon TenantBranding[] @relation("BrandingFavicon")

  @@index([tenantId, createdAt])
  @@map("tenant_files")
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

/// Append-only. `metadata` is redacted of secrets before insert (AuditService).
model AuditLog {
  id         String        @id @default(uuid(7)) @db.Uuid
  tenantId   String?       @map("tenant_id") @db.Uuid
  locationId String?       @map("location_id") @db.Uuid
  actorType  ActorType     @map("actor_type")
  actorId    String?       @map("actor_id") @db.Uuid
  source     ActionSource?
  action     String
  entityType String        @map("entity_type")
  entityId   String?       @map("entity_id")
  metadata   Json          @default("{}")
  requestId  String?       @map("request_id")
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([tenantId, createdAt])
  @@index([entityType, entityId])
  @@index([actorId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Catalog (menu). Tenant-level definitions; per-location availability and price overrides
// live in LocationProduct. Rows are archived (archived_at), never deleted, because historical
// orders and sync operations reference them.
// ---------------------------------------------------------------------------

model Category {
  id            String    @id @default(uuid(7)) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  nameEn        String    @map("name_en")
  nameAr        String    @map("name_ar")
  descriptionEn String?   @map("description_en")
  descriptionAr String?   @map("description_ar")
  sortOrder     Int       @default(0) @map("sort_order")
  archivedAt    DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  products Product[]

  @@index([tenantId, sortOrder])
  @@map("categories")
}

model Product {
  id            String    @id @default(uuid(7)) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  categoryId    String    @map("category_id") @db.Uuid
  /// Optional stock-keeping code, unique within the tenant when present.
  sku           String?
  nameEn        String    @map("name_en")
  nameAr        String    @map("name_ar")
  descriptionEn String?   @map("description_en")
  descriptionAr String?   @map("description_ar")
  /// Minor units. When the product has variants, the chosen variant's price is used instead.
  price         Int
  sortOrder     Int       @default(0) @map("sort_order")
  archivedAt    DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant           Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  category         Category               @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants         ProductVariant[]
  modifierGroups   ProductModifierGroup[]
  stations         ProductStation[]
  locationSettings LocationProduct[]
  taxes            ProductTax[]
  orderItems       OrderItem[]

  @@unique([tenantId, sku])
  @@index([tenantId, categoryId, sortOrder])
  @@map("products")
}

model ProductVariant {
  id         String    @id @default(uuid(7)) @db.Uuid
  productId  String    @map("product_id") @db.Uuid
  nameEn     String    @map("name_en")
  nameAr     String    @map("name_ar")
  /// Absolute price in minor units (not a delta).
  price      Int
  sortOrder  Int       @default(0) @map("sort_order")
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([productId])
  @@map("product_variants")
}

model ModifierGroup {
  id         String    @id @default(uuid(7)) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  nameEn     String    @map("name_en")
  nameAr     String    @map("name_ar")
  /// Minimum number of modifiers the customer must choose (0 = optional group).
  minSelect  Int       @default(0) @map("min_select")
  /// Maximum number of modifiers; null = unlimited.
  maxSelect  Int?      @map("max_select")
  sortOrder  Int       @default(0) @map("sort_order")
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant    Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  modifiers Modifier[]
  products  ProductModifierGroup[]

  @@index([tenantId])
  @@map("modifier_groups")
}

model Modifier {
  id              String    @id @default(uuid(7)) @db.Uuid
  modifierGroupId String    @map("modifier_group_id") @db.Uuid
  nameEn          String    @map("name_en")
  nameAr          String    @map("name_ar")
  /// Added to the item's unit price, minor units (0 for free options).
  priceDelta      Int       @default(0) @map("price_delta")
  /// Pre-selected in ordering UIs.
  isDefault       Boolean   @default(false) @map("is_default")
  sortOrder       Int       @default(0) @map("sort_order")
  archivedAt      DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  group ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Restrict)

  @@index([modifierGroupId])
  @@map("modifiers")
}

/// Attaches a modifier group to a product, optionally overriding the group's min/max.
model ProductModifierGroup {
  productId       String @map("product_id") @db.Uuid
  modifierGroupId String @map("modifier_group_id") @db.Uuid
  sortOrder       Int    @default(0) @map("sort_order")
  minSelect       Int?   @map("min_select")
  maxSelect       Int?   @map("max_select")

  product Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  group   ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Restrict)

  @@id([productId, modifierGroupId])
  @@map("product_modifier_groups")
}

/// Kitchen stations (Kitchen, Grill, Fryer, Bar, Dessert, ...) are defined per tenant; each
/// location's KDS screens subscribe to the stations they serve.
model KitchenStation {
  id         String    @id @default(uuid(7)) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  /// Short code, unique within the tenant, e.g. GRILL.
  code       String
  nameEn     String    @map("name_en")
  nameAr     String    @map("name_ar")
  sortOrder  Int       @default(0) @map("sort_order")
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  products ProductStation[]
  tickets  KitchenTicket[]

  @@unique([tenantId, code])
  @@map("kitchen_stations")
}

/// An order item is routed to every station its product is assigned to.
model ProductStation {
  productId        String @map("product_id") @db.Uuid
  kitchenStationId String @map("kitchen_station_id") @db.Uuid

  product Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  station KitchenStation @relation(fields: [kitchenStationId], references: [id], onDelete: Restrict)

  @@id([productId, kitchenStationId])
  @@map("product_stations")
}

/// Per-location product settings. A missing row means: available, base price.
model LocationProduct {
  locationId    String   @map("location_id") @db.Uuid
  productId     String   @map("product_id") @db.Uuid
  /// The "86" switch: false hides the product from ordering at this location.
  isAvailable   Boolean  @default(true) @map("is_available")
  /// Replaces the product base price at this location (minor units). Only for products
  /// without variants.
  priceOverride Int?     @map("price_override")
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@id([locationId, productId])
  @@map("location_products")
}

// ---------------------------------------------------------------------------
// Taxes & discounts (tenant configuration)
// ---------------------------------------------------------------------------

model Tax {
  id         String    @id @default(uuid(7)) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  nameEn     String    @map("name_en")
  nameAr     String    @map("name_ar")
  /// Basis points: 1500 = 15%.
  rateBps    Int       @map("rate_bps")
  /// Pre-selected for new products in the admin. Pricing never applies taxes implicitly.
  isDefault  Boolean   @default(false) @map("is_default")
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  products ProductTax[]

  @@index([tenantId])
  @@map("taxes")
}

model ProductTax {
  productId String @map("product_id") @db.Uuid
  taxId     String @map("tax_id") @db.Uuid

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tax     Tax     @relation(fields: [taxId], references: [id], onDelete: Restrict)

  @@id([productId, taxId])
  @@map("product_taxes")
}

/// Predefined order-level discounts staff may apply (requires orders.discount).
model Discount {
  id         String       @id @default(uuid(7)) @db.Uuid
  tenantId   String       @map("tenant_id") @db.Uuid
  nameEn     String       @map("name_en")
  nameAr     String       @map("name_ar")
  type       DiscountType
  /// Basis points for PERCENTAGE, minor units for FIXED.
  value      Int
  archivedAt DateTime?    @map("archived_at") @db.Timestamptz(3)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@map("discounts")
}

// ---------------------------------------------------------------------------
// Floor plan
// ---------------------------------------------------------------------------

model TableSection {
  id         String    @id @default(uuid(7)) @db.Uuid
  locationId String    @map("location_id") @db.Uuid
  nameEn     String    @map("name_en")
  nameAr     String    @map("name_ar")
  sortOrder  Int       @default(0) @map("sort_order")
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  location Location      @relation(fields: [locationId], references: [id], onDelete: Restrict)
  tables   DiningTable[]

  @@index([locationId])
  @@map("table_sections")
}

/// A dining table ("Table" in the domain model; renamed to avoid the SQL keyword).
model DiningTable {
  id         String    @id @default(uuid(7)) @db.Uuid
  locationId String    @map("location_id") @db.Uuid
  sectionId  String    @map("section_id") @db.Uuid
  /// Short label shown on the POS and tickets, unique per location, e.g. "T12".
  label      String
  seats      Int       @default(4)
  sortOrder  Int       @default(0) @map("sort_order")
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  location Location     @relation(fields: [locationId], references: [id], onDelete: Restrict)
  section  TableSection @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  orders   Order[]

  @@unique([locationId, label])
  @@map("dining_tables")
}

// ---------------------------------------------------------------------------
// Orders. One table for every channel. Lines, modifiers, taxes and discounts are snapshots:
// later menu edits never change an order. Orders are never deleted.
// ---------------------------------------------------------------------------

model Order {
  id              String           @id @default(uuid(7)) @db.Uuid
  tenantId        String           @map("tenant_id") @db.Uuid
  locationId      String           @map("location_id") @db.Uuid
  /// Human-readable, unique per location and business day, e.g. "MAIN-042".
  orderNumber     String           @map("order_number")
  businessDate    DateTime         @map("business_date") @db.Date
  channel         OrderChannel
  status          OrderStatus
  paymentStatus   PaymentStatus    @default(UNPAID) @map("payment_status")
  source          ActionSource
  tableId         String?          @map("table_id") @db.Uuid
  customerName    String?          @map("customer_name")
  customerPhone   String?          @map("customer_phone")
  guestCount      Int?             @map("guest_count")
  customerEmail   String?          @map("customer_email")
  /// Website orders: pickup or delivery; null for orders taken by staff.
  fulfillmentType FulfillmentType? @map("fulfillment_type")
  /// Delivery orders: { line1, line2?, city?, notes? }.
  deliveryAddress Json?            @map("delivery_address")
  notes           String?
  /// Snapshots of the pricing context at the time of the last pricing.
  currencyCode    String           @map("currency_code") @db.Char(3)
  taxInclusive    Boolean          @map("tax_inclusive")
  subtotal        Int
  discountTotal   Int              @map("discount_total")
  taxTotal        Int              @map("tax_total")
  feeTotal        Int              @map("fee_total")
  total           Int
  /// Incremented on every change; clients send it back for optimistic concurrency.
  version         Int              @default(1)
  createdById     String?          @map("created_by_id") @db.Uuid
  placedAt        DateTime?        @map("placed_at") @db.Timestamptz(3)
  /// Website orders: accept before this instant, or the cloud cancels the order (ADR 0013).
  acceptBy        DateTime?        @map("accept_by") @db.Timestamptz(3)
  completedAt     DateTime?        @map("completed_at") @db.Timestamptz(3)
  cancelledAt     DateTime?        @map("cancelled_at") @db.Timestamptz(3)
  cancelReason    String?          @map("cancel_reason")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  location      Location             @relation(fields: [locationId], references: [id], onDelete: Restrict)
  table         DiningTable?         @relation(fields: [tableId], references: [id], onDelete: Restrict)
  items         OrderItem[]
  taxes         OrderTax[]
  discounts     OrderDiscount[]
  statusHistory OrderStatusHistory[]
  payments      Payment[]
  tickets       KitchenTicket[]

  @@unique([locationId, businessDate, orderNumber])
  @@index([locationId, status])
  @@index([locationId, businessDate])
  @@index([tableId, status])
  @@map("orders")
}

model OrderItem {
  /// The client's cart line id, stable across edits.
  id            String   @id @db.Uuid
  orderId       String   @map("order_id") @db.Uuid
  productId     String   @map("product_id") @db.Uuid
  variantId     String?  @map("variant_id") @db.Uuid
  nameEn        String   @map("name_en")
  nameAr        String   @map("name_ar")
  variantNameEn String?  @map("variant_name_en")
  variantNameAr String?  @map("variant_name_ar")
  quantity      Int
  /// Product or variant price, before modifiers.
  basePrice     Int      @map("base_price")
  /// basePrice + modifier deltas.
  unitPrice     Int      @map("unit_price")
  gross         Int
  discount      Int
  tax           Int
  total         Int
  notes         String?
  /// Kitchen stations at the time of ordering (routing snapshot for Phase 4).
  /// JSON array of station ids (portable across PostgreSQL and the hub's SQLite).
  stationIds    Json     @default("[]") @map("station_ids")
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  order       Order               @relation(fields: [orderId], references: [id], onDelete: Restrict)
  product     Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  modifiers   OrderItemModifier[]
  ticketItems KitchenTicketItem[]

  @@index([orderId])
  @@map("order_items")
}

model OrderItemModifier {
  id              String @id @default(uuid(7)) @db.Uuid
  orderItemId     String @map("order_item_id") @db.Uuid
  modifierId      String @map("modifier_id") @db.Uuid
  modifierGroupId String @map("modifier_group_id") @db.Uuid
  nameEn          String @map("name_en")
  nameAr          String @map("name_ar")
  priceDelta      Int    @map("price_delta")

  item OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderItemId])
  @@map("order_item_modifiers")
}

/// Per-tax totals of an order (receipt and tax-report breakdown).
model OrderTax {
  orderId       String @map("order_id") @db.Uuid
  taxId         String @map("tax_id") @db.Uuid
  nameEn        String @map("name_en")
  nameAr        String @map("name_ar")
  rateBps       Int    @map("rate_bps")
  taxableAmount Int    @map("taxable_amount")
  amount        Int

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@id([orderId, taxId])
  @@map("order_taxes")
}

model OrderDiscount {
  id          String       @id @default(uuid(7)) @db.Uuid
  orderId     String       @map("order_id") @db.Uuid
  discountId  String       @map("discount_id") @db.Uuid
  nameEn      String       @map("name_en")
  nameAr      String       @map("name_ar")
  type        DiscountType
  value       Int
  amount      Int
  appliedById String?      @map("applied_by_id") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@map("order_discounts")
}

/// Append-only record of every status change.
model OrderStatusHistory {
  id         String       @id @default(uuid(7)) @db.Uuid
  orderId    String       @map("order_id") @db.Uuid
  fromStatus OrderStatus? @map("from_status")
  toStatus   OrderStatus  @map("to_status")
  actorType  ActorType    @map("actor_type")
  actorId    String?      @map("actor_id") @db.Uuid
  source     ActionSource
  reason     String?
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

/// Per-location, per-business-day order number sequence (incremented atomically).
model OrderCounter {
  locationId   String   @map("location_id") @db.Uuid
  businessDate DateTime @map("business_date") @db.Date
  lastNumber   Int      @map("last_number")

  location Location @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@id([locationId, businessDate])
  @@map("order_counters")
}

// ---------------------------------------------------------------------------
// Payments, shifts and cash. Financial rows are append-only: corrections are new rows
// (refunds, pay-outs), never edits or deletes.
// ---------------------------------------------------------------------------

/// A tender the location accepts, e.g. "Cash", "Mada", "Visa".
model PaymentMethod {
  id         String            @id @default(uuid(7)) @db.Uuid
  tenantId   String            @map("tenant_id") @db.Uuid
  type       PaymentMethodType
  nameEn     String            @map("name_en")
  nameAr     String            @map("name_ar")
  sortOrder  Int               @default(0) @map("sort_order")
  archivedAt DateTime?         @map("archived_at") @db.Timestamptz(3)
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  payments Payment[]

  @@index([tenantId])
  @@map("payment_methods")
}

/// One money movement on an order. The id is client-generated and is the idempotency key.
model Payment {
  id                 String                 @id @db.Uuid
  tenantId           String                 @map("tenant_id") @db.Uuid
  locationId         String                 @map("location_id") @db.Uuid
  orderId            String                 @map("order_id") @db.Uuid
  /// The drawer's shift. Null only for ONLINE payments, which touch no drawer (database CHECK).
  shiftId            String?                @map("shift_id") @db.Uuid
  paymentMethodId    String                 @map("payment_method_id") @db.Uuid
  /// Snapshot of the method type and names at the time of payment.
  methodType         PaymentMethodType      @map("method_type")
  methodNameEn       String                 @map("method_name_en")
  methodNameAr       String                 @map("method_name_ar")
  type               PaymentTransactionType
  status             PaymentRecordStatus
  /// Provider adapter that processed it (e.g. "cash", "external-card").
  provider           String
  /// Provider-side id (gateway transaction id); null for cash.
  providerRef        String?                @map("provider_ref")
  /// Applied to the order (minor units, always positive).
  amount             Int
  /// Cash handed over (CASH charges only).
  tendered           Int?
  /// Cash returned to the customer (CASH charges only).
  change             Int                    @default(0)
  /// Cash rounding difference kept in the drawer (CASH charges only).
  roundingAdjustment Int                    @default(0) @map("rounding_adjustment")
  /// Card approval code / terminal receipt number. Never a card number.
  reference          String?
  /// REFUND rows: the CHARGE being refunded.
  refundOfId         String?                @map("refund_of_id") @db.Uuid
  reason             String?
  createdById        String?                @map("created_by_id") @db.Uuid
  createdAt          DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  location Location          @relation(fields: [locationId], references: [id], onDelete: Restrict)
  order    Order             @relation(fields: [orderId], references: [id], onDelete: Restrict)
  shift    Shift?            @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  method   PaymentMethod     @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)
  refundOf Payment?          @relation("PaymentRefunds", fields: [refundOfId], references: [id], onDelete: Restrict)
  refunds  Payment[]         @relation("PaymentRefunds")
  cash     CashTransaction[]

  @@index([orderId])
  @@index([shiftId])
  @@index([locationId, createdAt])
  @@map("payments")
}

/// A physical cash drawer at a location.
model CashRegister {
  id         String    @id @default(uuid(7)) @db.Uuid
  locationId String    @map("location_id") @db.Uuid
  nameEn     String    @map("name_en")
  nameAr     String    @map("name_ar")
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  location Location @relation(fields: [locationId], references: [id], onDelete: Restrict)
  shifts   Shift[]

  @@index([locationId])
  @@map("cash_registers")
}

model Shift {
  id             String      @id @db.Uuid
  tenantId       String      @map("tenant_id") @db.Uuid
  locationId     String      @map("location_id") @db.Uuid
  cashRegisterId String      @map("cash_register_id") @db.Uuid
  status         ShiftStatus
  /// Equals cashRegisterId while the shift is open and null once closed: the unique index
  /// guarantees at most one open shift per drawer, even under concurrent requests.
  openRegisterId String?     @unique @map("open_register_id") @db.Uuid
  openingFloat   Int         @map("opening_float")
  openedById     String      @map("opened_by_id") @db.Uuid
  openedAt       DateTime    @default(now()) @map("opened_at") @db.Timestamptz(3)
  closedById     String?     @map("closed_by_id") @db.Uuid
  closedAt       DateTime?   @map("closed_at") @db.Timestamptz(3)
  /// Snapshot at closing: what the drawer should contain, what was counted, and the difference.
  expectedCash   Int?        @map("expected_cash")
  countedCash    Int?        @map("counted_cash")
  cashDifference Int?        @map("cash_difference")
  closingNotes   String?     @map("closing_notes")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  location     Location          @relation(fields: [locationId], references: [id], onDelete: Restrict)
  cashRegister CashRegister      @relation(fields: [cashRegisterId], references: [id], onDelete: Restrict)
  payments     Payment[]
  cash         CashTransaction[]

  @@index([locationId, status])
  @@map("shifts")
}

/// Cash movements in a drawer during a shift (sales and refunds are linked to their payment).
model CashTransaction {
  id          String              @id @db.Uuid
  shiftId     String              @map("shift_id") @db.Uuid
  type        CashTransactionType
  /// Positive minor units; the type gives the direction.
  amount      Int
  paymentId   String?             @map("payment_id") @db.Uuid
  reason      String?
  createdById String?             @map("created_by_id") @db.Uuid
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  shift   Shift    @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([shiftId])
  @@map("cash_transactions")
}

// ---------------------------------------------------------------------------
// Kitchen (Phase 4)
// ---------------------------------------------------------------------------

/// One per order and station. Created when the order is confirmed; the order's PREPARING/READY
/// statuses are derived from its tickets. Never deleted: cancelled tickets stay for history.
model KitchenTicket {
  id          String              @id @default(uuid(7)) @db.Uuid
  tenantId    String              @map("tenant_id") @db.Uuid
  locationId  String              @map("location_id") @db.Uuid
  orderId     String              @map("order_id") @db.Uuid
  stationId   String              @map("station_id") @db.Uuid
  status      KitchenTicketStatus @default(NEW)
  priority    TicketPriority      @default(NORMAL)
  /// Incremented on every change; kitchen screens send it back for optimistic concurrency.
  version     Int                 @default(1)
  /// Incremented when an order edit rewrites the items; screens flag tickets with revision > 1.
  revision    Int                 @default(1)
  startedAt   DateTime?           @map("started_at") @db.Timestamptz(3)
  readyAt     DateTime?           @map("ready_at") @db.Timestamptz(3)
  completedAt DateTime?           @map("completed_at") @db.Timestamptz(3)
  cancelledAt DateTime?           @map("cancelled_at") @db.Timestamptz(3)
  /// A cancelled ticket stays on the screen until the kitchen acknowledges it.
  dismissedAt DateTime?           @map("dismissed_at") @db.Timestamptz(3)
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant   Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  location Location            @relation(fields: [locationId], references: [id], onDelete: Restrict)
  order    Order               @relation(fields: [orderId], references: [id], onDelete: Restrict)
  station  KitchenStation      @relation(fields: [stationId], references: [id], onDelete: Restrict)
  items    KitchenTicketItem[]

  @@unique([orderId, stationId])
  @@index([locationId, status])
  @@index([locationId, updatedAt])
  @@map("kitchen_tickets")
}

/// What the station has to make: a snapshot of the order line (names, quantity, modifiers, notes).
model KitchenTicketItem {
  id            String    @id @default(uuid(7)) @db.Uuid
  ticketId      String    @map("ticket_id") @db.Uuid
  orderItemId   String    @map("order_item_id") @db.Uuid
  nameEn        String    @map("name_en")
  nameAr        String    @map("name_ar")
  variantNameEn String?   @map("variant_name_en")
  variantNameAr String?   @map("variant_name_ar")
  quantity      Int
  notes         String?
  /// [{ nameEn, nameAr }] in selection order.
  modifiers     Json      @default("[]")
  sortOrder     Int       @default(0) @map("sort_order")
  /// Struck through on the screen when the cook finished this line.
  doneAt        DateTime? @map("done_at") @db.Timestamptz(3)

  ticket    KitchenTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  orderItem OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([orderItemId])
  @@map("kitchen_ticket_items")
}

/// @cloud-only
enum ProcessedOperationStatus {
  APPLIED
  CONFLICT
  REJECTED

  @@map("processed_operation_status")
}

/// @cloud-only
enum ChangeTopic {
  CONFIG
  /// A website order the cloud created or changed (entityId = order id).
  ORDER
  /// An administrator resolved an operation refused from a hub (entityId = operation id).
  RESOLUTION

  @@map("change_topic")
}

/// @cloud-only
/// How an administrator settled a refused hub operation (ADR 0014).
enum SyncIssueResolution {
  APPLIED_HUB
  KEPT_CLOUD

  @@map("sync_issue_resolution")
}

/// @cloud-only
/// Idempotency ledger of operations pushed by location hubs. The operation id is the primary key,
/// so an operation can be applied once only. Refused operations are kept with their reason (for
/// administrators) and may be applied later if the hub retries them.
model ProcessedOperation {
  operationId       String                   @id @map("operation_id") @db.Uuid
  tenantId          String                   @map("tenant_id") @db.Uuid
  locationId        String                   @map("location_id") @db.Uuid
  deviceId          String                   @map("device_id") @db.Uuid
  entityType        String                   @map("entity_type")
  entityId          String                   @map("entity_id") @db.Uuid
  operationType     String                   @map("operation_type")
  /// The hub's per-entity outbox sequence: increases with every change the hub makes.
  entityVersion     Int                      @map("entity_version")
  /// The entity's own `version` column after applying (orders, tickets): if the cloud's row has
  /// moved on since, the cloud changed it and the next push is a conflict.
  rowVersion        Int?                     @map("row_version")
  status            ProcessedOperationStatus
  errorCode         String?                  @map("error_code")
  errorMessage      String?                  @map("error_message")
  attempts          Int                      @default(1)
  /// Refused operations: the hub's state as it was pushed, so an administrator can compare it
  /// with the cloud's copy and decide (ADR 0014). Kept after the decision; never shown to hubs.
  payload           Json?
  /// Set once an administrator settled the refusal; null while it is open.
  resolution        SyncIssueResolution?
  resolvedAt        DateTime?                @map("resolved_at") @db.Timestamptz(3)
  resolvedById      String?                  @map("resolved_by_id") @db.Uuid
  resolutionNote    String?                  @map("resolution_note")
  /// An administrator asked the hub to send the operation again (after fixing its cause).
  resendRequestedAt DateTime?                @map("resend_requested_at") @db.Timestamptz(3)
  createdAt         DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([entityType, entityId, status])
  @@index([locationId, status, updatedAt])
  @@map("processed_operations")
}

/// @cloud-only
/// Change feed read by location hubs (`GET /sync/pull`), ordered by `seq`, never by time. Written
/// by database triggers (configuration) so no code path can forget it; see the migration.
model ChangeLog {
  seq        BigInt      @id @default(autoincrement())
  tenantId   String      @map("tenant_id") @db.Uuid
  /// Null: concerns every location of the tenant.
  locationId String?     @map("location_id") @db.Uuid
  topic      ChangeTopic
  entityId   String?     @map("entity_id") @db.Uuid
  /// Writing transaction; one CONFIG row per transaction and tenant.
  txId       BigInt      @default(dbgenerated("txid_current()")) @map("tx_id")
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([tenantId, seq])
  @@map("change_log")
}

/// @cloud-only
/// Numbers of website orders (`W-001`) per location and business day. Separate from
/// `order_counters`, which the hub continues, so the two series never interfere.
model WebOrderCounter {
  locationId   String   @map("location_id") @db.Uuid
  businessDate DateTime @map("business_date") @db.Date
  lastNumber   Int      @map("last_number")

  @@id([locationId, businessDate])
  @@map("web_order_counters")
}

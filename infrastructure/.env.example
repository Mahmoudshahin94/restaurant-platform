# Copy to the repository root as `.env` (see docs/dev-setup.md). Never commit real secrets.

# --- Database ---------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pos_kds_dev?schema=public
# Integration tests run against a separate database that they reset.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pos_kds_test?schema=public

# --- API --------------------------------------------------------------------
NODE_ENV=development
API_PORT=3000
LOG_LEVEL=info
# At least 32 random characters. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-0123456789abcdef
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_REUSE_GRACE_SECONDS=10
# Comma-separated browser origins allowed to call the API with credentials.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5177
# Reverse proxies in front of the API whose X-Forwarded-For is trusted (rate limits are per IP).
TRUST_PROXY=0

# --- Tenant files (logos, favicons; docs/adr/0019) ----------------------------
# Local-disk storage of the API (relative to its working directory). A hub uses <HUB_DATA_DIR>/files.
FILE_STORAGE_DIR=.data/files

# --- Payment providers (docs/adr/0024) ------------------------------------------
# Each tenant picks its providers in the admin (Settings → Payment providers). Development
# adapters that take their method for every tenant WITHOUT an account of its own: `mock-online`
# (website card checkout, tokens tok_mock_…) and `mock-terminal` (kiosk card readers, every card
# approved). Refused in production; leave empty to see a cash-only business.
DEV_PAYMENT_PROVIDERS=mock-online,mock-terminal
# Master keys sealing provider secrets (AES-256-GCM envelope): `<version>:<base64 32 bytes>`,
# comma-separated, the highest version current (`openssl rand -base64 32`). REQUIRED by the
# cloud in production; when unset elsewhere, a development key is derived from JWT_ACCESS_SECRET.
# Rotate: add `2:<new key>`, run `pnpm --filter @pos/api payment-secrets:rotate`, then drop `1:`.
PAYMENT_SECRETS_KEY=1:ZGV2LW9ubHktcGF5bWVudC1zZWNyZXRzLWtleS0wMDE=

# --- Platform admin (cloud, docs/adr/0025) ------------------------------------
# Signing key of platform tokens (audience madar-platform) and support confirmations. When unset it
# is derived from JWT_ACCESS_SECRET (always a different key); set it to rotate the two separately.
# PLATFORM_JWT_SECRET=
# Server errors (5xx) kept per route and code each minute for the health board (0 = none).
PLATFORM_ERROR_SAMPLE_PER_MINUTE=10
# The first platform owner: PLATFORM_USER_PASSWORD=<12+ characters> pnpm platform:create-owner --
#   --email you@example.com --name "Your name"   (never put the password on the command line)

# --- Online ordering (cloud, docs/adr/0013) -----------------------------------
# A hub silent this long makes the location OFFLINE for online orders.
HUB_HEARTBEAT_STALE_SECONDS=180
# How often unaccepted website orders past their deadline are cancelled (0 = never).
WEB_ORDER_TIMEOUT_SWEEP_SECONDS=15
WEB_ORDER_RATE_LIMIT_PER_MINUTE=20
TRACKING_RATE_LIMIT_PER_MINUTE=120

# --- Tenant websites (cloud, docs/adr/0023) -----------------------------------
# Every tenant's site answers on <slug>.<PLATFORM_WEB_DOMAIN>: `localhost` in development (open
# http://demo-kitchen.localhost:5175), MADAR's web domain (e.g. madar.app) in production. The seed
# creates these addresses with the same value.
PLATFORM_WEB_DOMAIN=localhost
# How a browser reaches a tenant's site ({domain} = its domain): the admin's preview and domain links.
WEBSITE_URL=http://{domain}:5175
# Bare http://localhost:5175 shows this tenant (development only; refused in production).
DEV_DEFAULT_TENANT_SLUG=demo-kitchen
# Custom domains: `dns` looks the _madar-verify TXT record up; `mock` finds every record (development
# and tests only; refused in production).
DOMAIN_VERIFIER=mock

# --- Seed (development only) ------------------------------------------------
SEED_OWNER_EMAIL=owner@demo.local
SEED_OWNER_PASSWORD=Dev-Only-Owner-Pass-1
SEED_CASHIER_EMAIL=cashier@demo.local
SEED_CASHIER_PASSWORD=Dev-Only-Cashier-Pass-1
# 4–8 digits; the cashier signs in to the POS at the hub with employee code 1001 + this PIN.
SEED_CASHIER_PIN=2468
SEED_KITCHEN_EMAIL=kitchen@demo.local
SEED_KITCHEN_PASSWORD=Dev-Only-Kitchen-Pass-1
# Optional owners of the other demo tenants (packages/database/seed/tenants/, one per business
# type). Leave unset to seed those tenants without an account.
SEED_CAFE_OWNER_EMAIL=owner@cafe.local
SEED_CAFE_OWNER_PASSWORD=Dev-Only-Cafe-Pass-1
SEED_MARKET_OWNER_EMAIL=owner@market.local
SEED_MARKET_OWNER_PASSWORD=Dev-Only-Market-Pass-1
SEED_STYLE_OWNER_EMAIL=owner@style.local
SEED_STYLE_OWNER_PASSWORD=Dev-Only-Style-Pass-1

# --- Location hub (apps/gateway) ----------------------------------------------
HUB_PORT=4000
# SQLite database and signing key (relative to apps/gateway when run with pnpm --filter).
HUB_DATA_DIR=.hub-data
# Browser origins of LAN clients that use cookie sessions (the KDS).
HUB_CORS_ORIGINS=http://localhost:5174,http://localhost:1420
# Safety-net snapshot refresh; configuration changes arrive through the change feed in seconds.
HUB_SNAPSHOT_INTERVAL_SECONDS=1800
# Sync engine (docs/sync.md): long-poll wait, backoff while the cloud is unreachable, and how long
# completed outbox rows keep their payload.
HUB_PULL_WAIT_SECONDS=25
HUB_SYNC_RETRY_BASE_MS=2000
HUB_SYNC_RETRY_MAX_MS=60000
HUB_OUTBOX_RETENTION_DAYS=30

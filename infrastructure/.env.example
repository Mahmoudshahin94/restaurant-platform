# Copy to the repository root as `.env` (see docs/dev-setup.md). Never commit real secrets.

# --- Database ---------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pos_kds_dev?schema=public
# Integration tests run against a separate database that they reset.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pos_kds_test?schema=public

# --- API --------------------------------------------------------------------
NODE_ENV=development
API_PORT=3000
LOG_LEVEL=info
# At least 32 random characters. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-0123456789abcdef
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_REUSE_GRACE_SECONDS=10
# Comma-separated browser origins allowed to call the API with credentials.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# --- Seed (development only) ------------------------------------------------
SEED_OWNER_EMAIL=owner@demo.local
SEED_OWNER_PASSWORD=Dev-Only-Owner-Pass-1
SEED_CASHIER_EMAIL=cashier@demo.local
SEED_CASHIER_PASSWORD=Dev-Only-Cashier-Pass-1
# 4–8 digits; the cashier signs in to the POS at the hub with employee code 1001 + this PIN.
SEED_CASHIER_PIN=2468
SEED_KITCHEN_EMAIL=kitchen@demo.local
SEED_KITCHEN_PASSWORD=Dev-Only-Kitchen-Pass-1

# --- Location hub (apps/gateway) ----------------------------------------------
HUB_PORT=4000
# SQLite database and signing key (relative to apps/gateway when run with pnpm --filter).
HUB_DATA_DIR=.hub-data
# Browser origins of LAN clients that use cookie sessions (the KDS).
HUB_CORS_ORIGINS=http://localhost:5174,http://localhost:1420
HUB_SNAPSHOT_INTERVAL_SECONDS=300

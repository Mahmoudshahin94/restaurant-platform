{
  "name": "@pos/gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Location hub: serves the POS and KDS on the location LAN from a local SQLite database, keeps working without the Internet, and links the location to the cloud",
  "scripts": {
    "build": "nest build -p tsconfig.build.json",
    "dev": "nest start --watch -p tsconfig.build.json",
    "start": "node dist/main.js",
    "pair": "node dist/cli/pair.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-fastify": "11.2.7",
    "@pos/database": "workspace:*",
    "@pos/domain": "workspace:*",
    "@pos/server": "workspace:*",
    "@pos/shared-types": "workspace:*",
    "@pos/validation": "workspace:*",
    "fastify": "5.11.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.1.13"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@swc/core": "1.15.3",
    "@types/node": "22.20.5",
    "pino-pretty": "13.2.0",
    "unplugin-swc": "1.6.0",
    "vitest": "3.2.7"
  }
}

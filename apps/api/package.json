{
  "name": "@pos/api",
  "version": "0.1.0",
  "private": true,
  "description": "Cloud API: NestJS modular monolith on Fastify",
  "scripts": {
    "build": "nest build -p tsconfig.build.json",
    "dev": "nest start --watch -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "10.3.0",
    "@fastify/websocket": "11.3.1",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-fastify": "11.2.7",
    "@pos/database": "workspace:*",
    "@pos/domain": "workspace:*",
    "@pos/shared-types": "workspace:*",
    "@pos/validation": "workspace:*",
    "fastify": "5.11.3",
    "jose": "6.2.12",
    "pino": "10.4.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.1.13"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.7",
    "@swc/core": "1.15.3",
    "@types/node": "22.20.5",
    "@types/ws": "8.18.1",
    "pino-pretty": "13.2.0",
    "unplugin-swc": "1.6.0",
    "vitest": "3.2.7"
  }
}
